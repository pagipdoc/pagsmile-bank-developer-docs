{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Pagsmile Open API",
  "description": "Integrate Pagsmile accounts, Pix pay-ins and payouts, TED, refunds, MED cases and webhooks with the Pagsmile Open API v3.",
  "colors": {
    "primary": "#0E2A4B",
    "light": "#2BC196",
    "dark": "#0E2A4B"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#07111F"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "api": {
    "openapi": [
      "openapi/en.json",
      "openapi/pt-br.json"
    ],
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript",
        "go",
        "java",
        "php"
      ],
      "defaults": "all",
      "prefill": true,
      "autogenerate": false
    },
    "params": {
      "expanded": "closed"
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Banking platform",
      "href": "https://banking.pagsmile.com.br/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Pagsmile Open API"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "index",
                  "account-models",
                  "quickstart",
                  "api-access-setup",
                  "environments-and-credentials"
